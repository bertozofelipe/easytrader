---
// Widget gratuito "Advanced Chart" do TradingView (com indicadores embutidos).
interface Props {
  symbol: string;
}

const { symbol } = Astro.props;

const config = {
  autosize: true,
  symbol,
  interval: 'D',
  timezone: 'America/Sao_Paulo',
  theme: 'dark',
  style: '1',
  locale: 'br',
  backgroundColor: '#121826',
  gridColor: 'rgba(36, 48, 73, 0.4)',
  allow_symbol_change: false,
  hide_volume: false,
  support_host: 'https://www.tradingview.com',
};
---

<!-- O script do TradingView força height:100% no contêiner, então a altura fica no elemento de fora. -->
<div class="rounded-xl border border-border bg-surface p-3">
  <div class="h-[460px]">
    <div class="tradingview-widget-container">
      <div class="tradingview-widget-container__widget"></div>
      <script is:inline type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js" async set:html={JSON.stringify(config)} />
    </div>
  </div>
  <p class="text-xs text-muted mt-2">
    <a href={`https://br.tradingview.com/symbols/${symbol.replace(':', '-')}/`} rel="noopener nofollow" target="_blank" class="hover:text-text">
      Gráfico de {symbol} por TradingView
    </a>
  </p>
</div>
