---
import { langFromPath } from '../i18n';
import { t } from '../i18n/ui';
import { formatDateTime } from '../lib/format';
import { loadData, type TickerData } from '../lib/market';
import { renderTickerItems } from '../lib/render';

const lang = langFromPath(Astro.url.pathname);
const s = t(lang).common;
const data = await loadData<TickerData>('ticker');
---

<div class="border-b border-border bg-bg/60" data-ticker>
  <div class="max-w-6xl mx-auto px-4 h-9 flex items-center gap-4 text-sm">
    <ul class="flex-1 flex items-center gap-6 overflow-x-auto [scrollbar-width:none]" data-ticker-list aria-label={s.quotes}>
      {data ? <Fragment set:html={renderTickerItems(data.items, lang)} /> : <li class="text-muted">{s.loadingQuotes}</li>}
    </ul>
    <span class="hidden sm:block shrink-0 text-xs text-muted" data-ticker-time title={s.tickerNote}>
      {data ? `${s.updated} ${formatDateTime(data.updatedAt, lang)}` : ''}
    </span>
  </div>
</div>

<script>
  import { pageLang } from '../i18n';
  import { t } from '../i18n/ui';
  import { DATA_URL, STALE_AFTER_MS, type TickerData } from '../lib/market';
  import { formatRelative } from '../lib/format';
  import { renderTickerItems } from '../lib/render';

  const REFRESH_MS = 5 * 60 * 1000;
  const lang = pageLang();

  async function refresh() {
    const root = document.querySelector<HTMLElement>('[data-ticker]');
    if (!root) return;
    try {
      const res = await fetch(`${DATA_URL}/ticker.json`, { cache: 'no-cache' });
      if (!res.ok) return;
      const data: TickerData = await res.json();
      root.querySelector('[data-ticker-list]')!.innerHTML = renderTickerItems(data.items, lang);
      const time = root.querySelector<HTMLElement>('[data-ticker-time]')!;
      const stale = Date.now() - new Date(data.updatedAt).getTime() > STALE_AFTER_MS;
      time.textContent = `${stale ? '⚠ ' : ''}${t(lang).common.updated} ${formatRelative(data.updatedAt, Date.now(), lang)}`;
      time.classList.toggle('text-warn', stale);
    } catch {
      // Mantém o que já está na tela.
    }
  }

  refresh();
  setInterval(() => document.visibilityState === 'visible' && refresh(), REFRESH_MS);
</script>
