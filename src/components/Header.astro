---
import { NAV, SITE } from '../config';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-b border-border bg-surface/80 backdrop-blur sticky top-0 z-20">
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between gap-4">
    <a href="/" class="font-bold text-lg tracking-tight">
      <span class="text-accent">Easy</span>trader
    </a>

    <nav class="hidden md:flex items-center gap-1 text-sm" aria-label="Principal">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            'px-3 py-1.5 rounded-md transition-colors',
            isActive(item.href) ? 'bg-surface-2 text-text' : 'text-muted hover:text-text',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer px-3 py-1.5 rounded-md border border-border text-sm" aria-label="Abrir menu">
        Menu
      </summary>
      <nav class="absolute right-0 mt-2 w-48 rounded-lg border border-border bg-surface p-2 flex flex-col text-sm shadow-xl" aria-label={`Menu ${SITE.name}`}>
        {NAV.map((item) => (
          <a href={item.href} class:list={['px-3 py-2 rounded-md', isActive(item.href) ? 'bg-surface-2' : 'hover:bg-surface-2']}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
