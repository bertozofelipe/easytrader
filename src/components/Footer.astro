---
import { FOOTER_LINKS, SITE } from '../config';
import { hasRoute, langFromPath, route } from '../i18n';
import { t } from '../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const s = t(lang).footer;
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface mt-12">
  <div class="max-w-6xl mx-auto px-4 py-8 text-sm text-muted space-y-4">
    <p class="rounded-lg border border-warn/30 bg-warn/5 p-3 text-warn/90">
      <strong>{s.riskTitle}</strong> {s.risk}{' '}
      <a href={route('risk', lang)} class="underline">{s.more}</a>.
    </p>
    <div class="flex flex-wrap gap-x-4 gap-y-2">
      {FOOTER_LINKS.map((l) => (
        <a href={route(l.key, lang)} class="hover:text-text">{s[l.label]}{!hasRoute(l.key, lang) && ' (PT)'}</a>
      ))}
      <a href={SITE.repo} class="hover:text-text" rel="noopener">GitHub</a>
    </div>
    <p>© {year} {SITE.name}</p>
  </div>
</footer>
