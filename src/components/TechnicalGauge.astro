---
// Termômetro técnico do ativo: resumo de médias móveis e osciladores no
// gráfico diário (calculado pelo coletor em signals.json). Educacional: mostra o
// viés dos indicadores, sem recomendação de compra ou venda.
import type { Asset } from '../data/assets';
import { langFromPath, route } from '../i18n';
import { t } from '../i18n/ui';
import { MA_PERIODS } from '../lib/gauge';
import { renderGauge } from '../lib/gauge-view';
import { loadData, type SignalsData } from '../lib/market';

interface Props {
  asset: Asset;
}

const { asset } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const s = t(lang).gauge;
const signals = await loadData<SignalsData>('signals');
const gauge = signals?.assets[asset.slug];
const periods = MA_PERIODS.join(', ');
const risk = route('risk', lang);

const T = {
  pt: {
    lead: 'Resume o que as médias móveis e os osciladores estão mostrando. Indica o viés dos indicadores, não é recomendação de compra ou venda.',
    how: 'Como é calculado',
    calculating: 'Calculando…',
    method: [
      `<strong>Médias móveis (12):</strong> simples e exponenciais de ${periods} dias. Cada uma vota <em>alta</em> se o fechamento está acima dela e <em>baixa</em> se está abaixo.`,
      '<strong>Osciladores (7):</strong> RSI, estocástico, CCI, ADX, momento, MACD e %B de Bollinger. Cada um vota alta, neutro ou baixa pela regra mostrada na tabela.',
      'Cada grupo vira uma nota de −1 (todos em baixa) a +1 (todos em alta); o resumo é a média dos dois grupos, com peso igual. Faixas: <span class="text-up">forte alta</span> a partir de +0,5 · <span class="text-up">alta</span> acima de +0,1 · <span class="text-muted">neutro</span> entre −0,1 e +0,1 · <span class="text-down">baixa</span> abaixo de −0,1 · <span class="text-down">forte baixa</span> até −0,5.',
    ],
    fine: `Usa candles diários já fechados (cripto: Binance, 0h UTC; ações, ETFs e VIX: Cboe; câmbio: BCE) e é recalculado a cada poucas horas. Indicadores olham o passado: não preveem o preço e podem divergir entre si. Veja o <a href="${risk}" class="text-accent">aviso de risco</a>.`,
  },
  en: {
    lead: 'Summarizes what the moving averages and oscillators are showing. It reflects the indicators’ bias and is not a recommendation to buy or sell.',
    how: 'How it is calculated',
    calculating: 'Calculating…',
    method: [
      `<strong>Moving averages (12):</strong> simple and exponential, ${periods} days. Each one votes <em>bullish</em> if the close is above it and <em>bearish</em> if below.`,
      '<strong>Oscillators (7):</strong> RSI, stochastic, CCI, ADX, momentum, MACD and Bollinger %B. Each votes bullish, neutral or bearish using the rule shown in the table.',
      'Each group becomes a score from −1 (all bearish) to +1 (all bullish); the summary is the average of both groups, equally weighted. Bands: <span class="text-up">strong bullish</span> from +0.5 · <span class="text-up">bullish</span> above +0.1 · <span class="text-muted">neutral</span> between −0.1 and +0.1 · <span class="text-down">bearish</span> below −0.1 · <span class="text-down">strong bearish</span> at −0.5 or lower.',
    ],
    fine: `Uses closed daily candles (crypto: Binance, 00:00 UTC; stocks, ETFs and VIX: Cboe; FX: ECB) and is recalculated every few hours. Indicators look backward: they do not predict price and may disagree with each other. See the <a href="${risk}" class="text-accent">risk disclaimer</a>.`,
  },
}[lang];
---

<section class="rounded-xl border border-border bg-surface p-5" aria-labelledby="termometro" data-gauge data-slug={asset.slug} data-kind={asset.kind} data-key={gauge ? `${gauge.asOf}|${gauge.score}` : undefined}>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="termometro" class="text-xl font-semibold">
      {s.title} <span class="ml-1 align-middle text-xs font-normal rounded-full border border-border px-2 py-0.5 text-muted">{s.daily}</span>
    </h2>
    <a href="#metodologia" class="text-sm text-accent" data-gauge-method-link>{T.how}</a>
  </div>
  <p class="text-xs text-muted mt-1">{T.lead}</p>

  <div class="mt-5" data-gauge-body>
    {gauge ? <Fragment set:html={renderGauge(gauge, asset.kind, lang)} /> : <p class="text-sm text-muted">{T.calculating}</p>}
  </div>

  <details id="metodologia" class="mt-3 scroll-mt-20" data-gauge-method>
    <summary class="cursor-pointer text-sm text-accent select-none">{T.how}</summary>
    <div class="text-sm text-text/90 leading-relaxed mt-2 space-y-2 max-w-3xl">
      {T.method.map((p) => <p set:html={p} />)}
      <p class="text-muted text-xs" set:html={T.fine} />
    </div>
  </details>
</section>

<script>
  import type { AssetKind } from '../data/assets';
  import { pageLang } from '../i18n';
  import { renderGauge } from '../lib/gauge-view';
  import { every, REFRESH_MS } from '../lib/live';
  import { fetchLatest, type SignalsData } from '../lib/market';

  const root = document.querySelector<HTMLElement>('[data-gauge]');
  const lang = pageLang();

  if (root) {
    const body = root.querySelector<HTMLElement>('[data-gauge-body]')!;
    const method = root.querySelector<HTMLDetailsElement>('[data-gauge-method]')!;
    root.querySelector('[data-gauge-method-link]')!.addEventListener('click', () => (method.open = true));
    if (location.hash === '#metodologia') method.open = true;

    let shown = root.dataset.key ?? null;
    every(REFRESH_MS, async () => {
      const data = await fetchLatest<SignalsData>('signals');
      const g = data?.assets[root.dataset.slug!];
      if (!g) {
        if (!shown) {
          body.innerHTML = `<p class="text-sm text-muted">${lang === 'en' ? 'Gauge unavailable right now. Please try again later.' : 'Termômetro indisponível agora. Tente de novo mais tarde.'}</p>`;
        }
        return;
      }
      // Só redesenha quando muda, para não fechar a tabela aberta.
      const key = `${g.asOf}|${g.score}`;
      if (key === shown) return;
      shown = key;
      body.innerHTML = renderGauge(g, root.dataset.kind as AssetKind, lang);
    });
  }
</script>
