---
// Gráfico de candles com volume (Lightweight Charts) alimentado pela API
// pública de dados de mercado da Binance, direto do navegador.
interface Props {
  pair: string;
}

const { pair } = Astro.props;

const INTERVALS = [
  { id: '1h', label: '1H' },
  { id: '4h', label: '4H' },
  { id: '1d', label: '1D' },
  { id: '1w', label: '1S' },
];
---

<div class="rounded-xl border border-border bg-surface p-3" data-crypto-chart data-pair={pair}>
  <div class="flex items-center justify-between gap-2 mb-2">
    <div class="flex gap-1" role="group" aria-label="Tempo gráfico">
      {INTERVALS.map((i) => (
        <button type="button" data-interval={i.id} class="px-2.5 py-1 rounded-md text-xs text-muted hover:text-text aria-pressed:bg-surface-2 aria-pressed:text-text" aria-pressed={i.id === '1d' ? 'true' : 'false'}>
          {i.label}
        </button>
      ))}
    </div>
    <span class="text-xs text-muted">{pair} · Binance · horário de Brasília</span>
  </div>
  <div class="h-[420px] relative" data-chart-el>
    <p class="absolute inset-0 grid place-items-center text-sm text-muted" data-chart-msg>Carregando gráfico…</p>
  </div>
</div>

<script>
  import { CandlestickSeries, ColorType, HistogramSeries, createChart, type UTCTimestamp } from 'lightweight-charts';

  const LIMITS: Record<string, number> = { '1h': 168, '4h': 180, '1d': 365, '1w': 260 };
  const BRT_OFFSET = -3 * 3600; // Brasil sem horário de verão desde 2019.
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

  for (const root of document.querySelectorAll<HTMLElement>('[data-crypto-chart]')) {
    const pair = root.dataset.pair!;
    const el = root.querySelector<HTMLElement>('[data-chart-el]')!;
    const msg = root.querySelector<HTMLElement>('[data-chart-msg]')!;
    const up = css('--color-up');
    const down = css('--color-down');

    const chart = createChart(el, {
      autoSize: true,
      layout: { background: { type: ColorType.Solid, color: 'transparent' }, textColor: css('--color-muted'), attributionLogo: true },
      grid: { vertLines: { color: css('--color-border') + '55' }, horzLines: { color: css('--color-border') + '55' } },
      rightPriceScale: { borderColor: css('--color-border') },
      timeScale: { borderColor: css('--color-border'), timeVisible: true },
      localization: { locale: 'pt-BR' },
    });
    const candles = chart.addSeries(CandlestickSeries, { upColor: up, downColor: down, wickUpColor: up, wickDownColor: down, borderVisible: false });
    const volume = chart.addSeries(HistogramSeries, { priceFormat: { type: 'volume' }, priceScaleId: '' });
    volume.priceScale().applyOptions({ scaleMargins: { top: 0.82, bottom: 0 } });

    // Se o gráfico foi montado sem largura (aba em segundo plano, layout ainda
    // calculando), reajusta o zoom quando ele ganhar tamanho.
    let lastWidth = el.clientWidth;
    new ResizeObserver(() => {
      if (lastWidth === 0 && el.clientWidth > 0) chart.timeScale().fitContent();
      lastWidth = el.clientWidth;
    }).observe(el);

    async function load(interval: string) {
      msg.hidden = false;
      msg.textContent = 'Carregando gráfico…';
      try {
        const res = await fetch(`https://data-api.binance.vision/api/v3/klines?symbol=${pair}&interval=${interval}&limit=${LIMITS[interval]}`);
        if (!res.ok) throw new Error(String(res.status));
        const rows: [number, string, string, string, string, string][] = await res.json();
        const intraday = interval.endsWith('h');
        const t = (ms: number) => (ms / 1000 + (intraday ? BRT_OFFSET : 0)) as UTCTimestamp;
        candles.setData(rows.map((r) => ({ time: t(r[0]), open: +r[1], high: +r[2], low: +r[3], close: +r[4] })));
        volume.setData(
          rows.map((r) => ({ time: t(r[0]), value: +r[5], color: (+r[4] >= +r[1] ? up : down) + '66' })),
        );
        chart.timeScale().fitContent();
        msg.hidden = true;
      } catch {
        msg.textContent = 'Não foi possível carregar o gráfico agora.';
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-interval]').forEach((btn) =>
      btn.addEventListener('click', () => {
        root.querySelectorAll('[data-interval]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        load(btn.dataset.interval!);
      }),
    );

    load('1d');
  }
</script>
