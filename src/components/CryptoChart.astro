---
// Gráfico de candles com volume e indicadores (Lightweight Charts), alimentado
// pela API pública de dados de mercado da Binance, direto do navegador.
import { guidePath, langFromPath } from '../i18n';
import { INDICATOR_TOGGLES } from '../lib/indicator-toggles';

interface Props {
  pair: string;
}

const { pair } = Astro.props;
const lang = langFromPath(Astro.url.pathname);

const T = {
  pt: { timeframe: 'Tempo gráfico', tz: 'horário de Brasília', indicators: 'Indicadores', whatIs: (l: string) => `O que é ${l}?`, week: '1S', loading: 'Carregando gráfico…' },
  en: { timeframe: 'Timeframe', tz: 'Brasília time (UTC−3)', indicators: 'Indicators', whatIs: (l: string) => `What is ${l}? (guide in Portuguese)`, week: '1W', loading: 'Loading chart…' },
}[lang];

const INTERVALS = [
  { id: '1h', label: '1H' },
  { id: '4h', label: '4H' },
  { id: '1d', label: '1D' },
  { id: '1w', label: T.week },
];
// "MM" (média móvel) vira "MA" em inglês.
const toggleLabel = (label: string) => (lang === 'en' ? label.replace(/^MM /, 'MA ') : label);
---

<div class="rounded-xl border border-border bg-surface p-3" data-crypto-chart data-pair={pair}>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
    <div class="flex gap-1" role="group" aria-label={T.timeframe}>
      {INTERVALS.map((i) => (
        <button type="button" data-interval={i.id} class="px-2.5 py-1 rounded-md text-xs text-muted hover:text-text aria-pressed:bg-surface-2 aria-pressed:text-text" aria-pressed={i.id === '1d' ? 'true' : 'false'}>
          {i.label}
        </button>
      ))}
    </div>
    <span class="text-xs text-muted">{pair} · Binance · {T.tz}</span>
  </div>

  <div class="flex flex-wrap items-center gap-1.5 mb-2" role="group" aria-label={T.indicators}>
    {INDICATOR_TOGGLES.map((t) => (
      <span class="inline-flex items-center rounded-md border border-border text-xs overflow-hidden">
        <button type="button" data-indicator={t.id} aria-pressed="false" class="flex items-center gap-1.5 px-2 py-1 text-muted hover:text-text aria-pressed:bg-surface-2 aria-pressed:text-text">
          <span class="w-2.5 h-0.5 rounded" style={`background:${t.color}`}></span>{toggleLabel(t.label)}
        </button>
        <a href={guidePath(t.guide)} class="px-1.5 py-1 border-l border-border text-muted hover:text-accent" title={T.whatIs(toggleLabel(t.label))} aria-label={T.whatIs(toggleLabel(t.label))}>?</a>
      </span>
    ))}
  </div>

  <div class="h-[440px] relative transition-[height]" data-chart-el>
    <p class="absolute inset-0 grid place-items-center text-sm text-muted z-10" data-chart-msg>{T.loading}</p>
  </div>
</div>

<script>
  import { CandlestickSeries, ColorType, HistogramSeries, createChart, type UTCTimestamp } from 'lightweight-charts';
  import { DEFAULT_INDICATORS, INDICATOR_TOGGLES, drawIndicators, type Candle, type IndicatorId } from '../lib/chart-indicators';
  import { LOCALE, pageLang } from '../i18n';

  const lang = pageLang();
  const MSG = {
    pt: { loading: 'Carregando gráfico…', error: 'Não foi possível carregar o gráfico agora.' },
    en: { loading: 'Loading chart…', error: 'Could not load the chart right now.' },
  }[lang];

  const LIMITS: Record<string, number> = { '1h': 500, '4h': 500, '1d': 500, '1w': 300 };
  const BRT_OFFSET = -3 * 3600; // Brasil sem horário de verão desde 2019.
  const BASE_HEIGHT = 440;
  const OSC_HEIGHT = 130;
  const STORE_KEY = 'easytrader:chart-indicators';
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

  function loadActive(): Set<IndicatorId> {
    try {
      const saved = JSON.parse(localStorage.getItem(STORE_KEY) ?? 'null');
      if (Array.isArray(saved)) return new Set(saved.filter((id) => INDICATOR_TOGGLES.some((t) => t.id === id)));
    } catch {
      // Sem localStorage: usa o padrão.
    }
    return new Set(DEFAULT_INDICATORS);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-crypto-chart]')) {
    const pair = root.dataset.pair!;
    const el = root.querySelector<HTMLElement>('[data-chart-el]')!;
    const msg = root.querySelector<HTMLElement>('[data-chart-msg]')!;
    const up = css('--color-up');
    const down = css('--color-down');
    const active = loadActive();
    let candles: Candle[] = [];

    const chart = createChart(el, {
      autoSize: true,
      layout: { background: { type: ColorType.Solid, color: 'transparent' }, textColor: css('--color-muted'), attributionLogo: true, panes: { separatorColor: css('--color-border') } },
      grid: { vertLines: { color: css('--color-border') + '55' }, horzLines: { color: css('--color-border') + '55' } },
      rightPriceScale: { borderColor: css('--color-border') },
      timeScale: { borderColor: css('--color-border'), timeVisible: true },
      localization: { locale: LOCALE[lang] },
    });
    const candleSeries = chart.addSeries(CandlestickSeries, { upColor: up, downColor: down, wickUpColor: up, wickDownColor: down, borderVisible: false });
    const volume = chart.addSeries(HistogramSeries, { priceFormat: { type: 'volume' }, priceScaleId: '', lastValueVisible: false, priceLineVisible: false });
    volume.priceScale().applyOptions({ scaleMargins: { top: 0.85, bottom: 0 } });

    // Se o gráfico foi montado sem largura (aba em segundo plano, layout ainda
    // calculando), reajusta o zoom quando ele ganhar tamanho.
    let lastWidth = el.clientWidth;
    new ResizeObserver(() => {
      if (lastWidth === 0 && el.clientWidth > 0) chart.timeScale().fitContent();
      lastWidth = el.clientWidth;
    }).observe(el);

    let clearIndicators = () => {};

    function redrawIndicators() {
      clearIndicators();
      const result = drawIndicators(chart, candles, active);
      clearIndicators = result.clear;
      el.style.height = `${BASE_HEIGHT + result.oscillators * OSC_HEIGHT}px`;
      root.querySelectorAll<HTMLElement>('[data-indicator]').forEach((b) => b.setAttribute('aria-pressed', String(active.has(b.dataset.indicator as IndicatorId))));
    }

    async function load(interval: string) {
      msg.hidden = false;
      msg.textContent = MSG.loading;
      try {
        const res = await fetch(`https://data-api.binance.vision/api/v3/klines?symbol=${pair}&interval=${interval}&limit=${LIMITS[interval]}`);
        if (!res.ok) throw new Error(String(res.status));
        const rows: [number, string, string, string, string, string][] = await res.json();
        const intraday = interval.endsWith('h');
        candles = rows.map((r) => ({
          time: (r[0] / 1000 + (intraday ? BRT_OFFSET : 0)) as UTCTimestamp,
          open: +r[1],
          high: +r[2],
          low: +r[3],
          close: +r[4],
          volume: +r[5],
        }));
        candleSeries.setData(candles);
        volume.setData(candles.map((c) => ({ time: c.time, value: c.volume, color: (c.close >= c.open ? up : down) + '55' })));
        redrawIndicators();
        // Mostra os últimos ~150 candles; o resto (usado no cálculo das médias longas) fica à esquerda.
        chart.timeScale().setVisibleLogicalRange({ from: Math.max(0, candles.length - 150), to: candles.length + 3 });
        msg.hidden = true;
      } catch {
        msg.textContent = MSG.error;
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-interval]').forEach((btn) =>
      btn.addEventListener('click', () => {
        root.querySelectorAll('[data-interval]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        load(btn.dataset.interval!);
      }),
    );

    root.querySelectorAll<HTMLButtonElement>('[data-indicator]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const id = btn.dataset.indicator as IndicatorId;
        if (active.has(id)) active.delete(id);
        else active.add(id);
        try {
          localStorage.setItem(STORE_KEY, JSON.stringify([...active]));
        } catch {
          // Ignora: a escolha só não fica salva.
        }
        if (candles.length) redrawIndicators();
      }),
    );

    load('1d');
  }
</script>
