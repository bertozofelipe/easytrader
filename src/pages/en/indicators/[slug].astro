---
import { getCollection } from 'astro:content';
import IndicatorPage from '../../../views/IndicatorPage.astro';
import { GUIDE_SLUG_EN } from '../../../i18n';

export async function getStaticPaths() {
  const items = (await getCollection('indicatorsEn')).sort((a, b) => a.data.ordem - b.data.ordem);
  // GUIDE_SLUG_EN (usado no navegador) precisa bater com o campo `pt` de cada guia.
  for (const item of items) {
    if (GUIDE_SLUG_EN[item.data.pt] !== item.id) {
      throw new Error(`Guia en/${item.id}: GUIDE_SLUG_EN['${item.data.pt}'] deveria ser '${item.id}' (src/i18n/index.ts)`);
    }
  }
  return items.map((item, i) => ({
    params: { slug: item.id },
    props: { item, prev: items[i - 1] ?? null, next: items[i + 1] ?? null },
  }));
}

const { item, prev, next } = Astro.props;
---

<IndicatorPage lang="en" item={item} prev={prev} next={next} />
