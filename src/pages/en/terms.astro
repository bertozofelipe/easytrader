---
import Layout from '../../layouts/Layout.astro';
import { route } from '../../i18n';
---

<Layout title="Terms of use" alternates={{ pt: route('terms', 'pt'), en: route('terms', 'en') }}>
  <article class="prose-et max-w-3xl">
    <h1>Terms of use</h1>
    <p class="text-warn">Draft — to be reviewed before launch. If this version and the Portuguese one differ, the Portuguese version prevails.</p>
    <p>By using Easytrader you agree to these terms.</p>
    <h2>1. Nature of the content</h2>
    <p>The content is educational and informational. Read the <a href={route('risk', 'en')}>risk disclaimer</a>.</p>
    <h2>2. Third-party data</h2>
    <p>Quotes, news and widgets are provided by third parties and are subject to their terms. We do not guarantee accuracy, completeness or availability.</p>
    <h2>3. Intellectual property</h2>
    <p>News belongs to its publishers and is shown only as a headline, excerpt and link. The site's code is open on GitHub.</p>
    <h2>4. Limitation of liability</h2>
    <p>Easytrader is not liable for losses arising from the use of the information published here.</p>
    <h2>5. Changes</h2>
    <p>These terms may be updated at any time.</p>
  </article>
</Layout>
