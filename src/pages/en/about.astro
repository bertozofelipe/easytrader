---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../config';
import { route } from '../../i18n';
---

<Layout title="About" alternates={{ pt: route('about', 'pt'), en: route('about', 'en') }}>
  <article class="prose-et max-w-3xl">
    <h1>About Easytrader</h1>
    <p>
      Easytrader brings together what traders use every day: news, an economic calendar, asset analysis with a technical
      gauge, technical indicators and trading calculators — focused on global markets and crypto.
    </p>
    <p>
      The site started in Portuguese and is now available in English as well; the trading school is still being written
      and will come in both languages.
    </p>
    <p>It is an independent, free and open-source project. <a href={SITE.repo}>See it on GitHub</a>.</p>
  </article>
</Layout>
