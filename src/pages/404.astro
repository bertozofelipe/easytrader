---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada">
  <div class="py-20 text-center">
    <p class="text-6xl font-bold text-accent">404</p>
    <p class="mt-4 text-muted">Essa página não existe (ainda).</p>
    <a href="/" class="inline-block mt-6 px-4 py-2 rounded-lg border border-border hover:bg-surface-2">Voltar ao início</a>
  </div>
</Layout>
