---
import { getCollection } from 'astro:content';
import IndicatorPage from '../../views/IndicatorPage.astro';

export async function getStaticPaths() {
  const items = (await getCollection('indicadores')).sort((a, b) => a.data.ordem - b.data.ordem);
  return items.map((item, i) => ({
    params: { slug: item.id },
    props: { item, prev: items[i - 1] ?? null, next: items[i + 1] ?? null },
  }));
}

const { item, prev, next } = Astro.props;
---

<IndicatorPage lang="pt" item={item} prev={prev} next={next} />
