---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ComingSoon from '../components/ComingSoon.astro';
---

<Layout title="Calendário econômico" description="Calendário econômico global com horário de Brasília e nível de impacto.">
  <PageHeader title="Calendário econômico" subtitle="Eventos que movem o mercado, com horário de Brasília, impacto e valores anterior, previsto e realizado." />
  <ComingSoon phase="Etapa 3" items={['Calendário global (widget TradingView)', 'Filtros por país e impacto', 'Explicação dos principais eventos (Payroll, CPI, FOMC...)']} />
</Layout>
