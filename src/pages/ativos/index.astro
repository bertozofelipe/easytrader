---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataStamp from '../../components/DataStamp.astro';
import WatchlistBox from '../../components/WatchlistBox.astro';
import { ASSET_GROUPS } from '../../data/assets';
import { loadData, loadDatasets, type SignalsData } from '../../lib/market';
import { collectRows, renderAssetRows } from '../../lib/render';

const ds = await loadDatasets();
const signals = await loadData<SignalsData>('signals');
const rows = collectRows(ds);
---

<Layout title="Ativos" description="Índices, VIX, ações dos EUA, câmbio e criptomoedas com cotação, variação e gráfico.">
  <PageHeader title="Ativos" subtitle="Escolha um ativo para ver gráfico, dados do dia, termômetro técnico e contexto. Use a estrela para montar a sua lista." />

  <div class="mb-6"><WatchlistBox /></div>

  <div class="grid gap-6 md:grid-cols-2">
    {ASSET_GROUPS.map((g) => (
      <section class="rounded-xl border border-border bg-surface p-5" id={g.id}>
        <h2 class="font-semibold">{g.title}</h2>
        <p class="text-xs text-muted mb-2">{g.note}</p>
        <table class="w-full text-sm">
          <thead class="sr-only"><tr><th>Acompanhar</th><th>Ativo</th><th>Preço</th><th>Variação</th><th>Termômetro técnico</th></tr></thead>
          <tbody data-asset-group={g.id}>
            <Fragment set:html={renderAssetRows(rows.filter((r) => g.kinds.includes(r.asset.kind)), { watch: true, signals })} />
          </tbody>
        </table>
      </section>
    ))}
  </div>

  <p class="text-xs text-muted mt-4">
    A etiqueta à direita é o <strong class="text-text">termômetro técnico</strong>: o viés de 19 indicadores no gráfico diário
    (forte alta, alta, neutro, baixa, forte baixa), calculado com o último fechamento. Não é recomendação de compra ou venda.
    Detalhes na página de cada ativo.
  </p>

  <div class="mt-2">
    <DataStamp name="us" updatedAt={ds.us?.updatedAt} source="Finnhub, Cboe, BCE (Frankfurter), CoinGecko" />
  </div>
</Layout>

<script>
  import { ASSET_GROUPS } from '../../data/assets';
  import { fetchDatasets, fetchLatest, type SignalsData } from '../../lib/market';
  import { collectRows, renderAssetRows } from '../../lib/render';
  import { every, REFRESH_MS, setHtml, setStamp } from '../../lib/live';
  import { syncWatchButtons } from '../../lib/watchlist';

  every(REFRESH_MS, async () => {
    const [ds, signals] = await Promise.all([fetchDatasets(), fetchLatest<SignalsData>('signals')]);
    if (!Object.values(ds).some(Boolean)) return;
    const rows = collectRows(ds);
    for (const g of ASSET_GROUPS) {
      setHtml(`[data-asset-group="${g.id}"]`, renderAssetRows(rows.filter((r) => g.kinds.includes(r.asset.kind)), { watch: true, signals }));
    }
    syncWatchButtons();
    if (ds.us) setStamp('us', ds.us.updatedAt);
  });
</script>
