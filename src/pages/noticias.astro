---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import DataStamp from '../components/DataStamp.astro';
import { loadData, type NewsData } from '../lib/market';
import { NEWS_CATEGORY_LABEL, renderNewsItems } from '../lib/render';

const news = await loadData<NewsData>('news');
const sources = news ? [...new Set(news.items.map((n) => n.source))].sort() : [];

const CATEGORIES = [['todas', 'Todas'], ...Object.entries(NEWS_CATEGORY_LABEL)];
const LANGS = [
  ['todos', 'Todos os idiomas'],
  ['pt', 'Português'],
  ['en', 'Inglês'],
];
---

<Layout title="Notícias" description="Notícias do mercado global, Brasil, forex e cripto agregadas de fontes confiáveis, com link para a matéria original.">
  <PageHeader title="Notícias" subtitle="O que move o mercado, agregado de fontes confiáveis. Clique para ler a matéria completa no site original." />

  <div class="flex flex-col gap-3 mb-4" data-news-filters>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Categoria">
      {CATEGORIES.map(([id, label]) => (
        <button type="button" data-filter-category={id} aria-pressed={id === 'todas' ? 'true' : 'false'} class="px-3 py-1.5 rounded-full border border-border text-sm text-muted hover:text-text aria-pressed:bg-accent aria-pressed:border-accent aria-pressed:text-white">
          {label}
        </button>
      ))}
    </div>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Idioma">
      {LANGS.map(([id, label]) => (
        <button type="button" data-filter-lang={id} aria-pressed={id === 'todos' ? 'true' : 'false'} class="px-3 py-1 rounded-full border border-border text-xs text-muted hover:text-text aria-pressed:bg-surface-2 aria-pressed:text-text">
          {label}
        </button>
      ))}
    </div>
  </div>

  <section class="rounded-xl border border-border bg-surface px-5 py-2">
    <ul data-news-list>
      {news ? <Fragment set:html={renderNewsItems(news.items)} /> : <li class="py-6 text-center text-muted">Carregando notícias…</li>}
    </ul>
    <p class="py-6 text-center text-muted text-sm" data-news-empty hidden>Nenhuma notícia nesse filtro nas últimas 48 horas.</p>
  </section>

  <div class="mt-4 space-y-1">
    <DataStamp name="news" updatedAt={news?.updatedAt} />
    <p class="text-xs text-muted">
      Fontes: {sources.join(', ') || '—'}. Os títulos e trechos pertencem aos respectivos veículos. O Easytrader não produz nem
      edita essas notícias.
    </p>
  </div>
</Layout>

<script>
  import { fetchLatest, type NewsData } from '../lib/market';
  import { renderNewsItems } from '../lib/render';
  import { every, REFRESH_MS, setHtml, setStamp } from '../lib/live';

  const STORE_KEY = 'easytrader:news-filter';
  const state = { category: 'todas', lang: 'todos' };
  try {
    Object.assign(state, JSON.parse(localStorage.getItem(STORE_KEY) ?? '{}'));
  } catch {
    // Sem localStorage (modo privado etc.): usa o padrão.
  }

  function applyFilter() {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('[data-news-list] li[data-category]').forEach((li) => {
      const show =
        (state.category === 'todas' || li.dataset.category === state.category) && (state.lang === 'todos' || li.dataset.lang === state.lang);
      li.hidden = !show;
      if (show) visible++;
    });
    document.querySelector<HTMLElement>('[data-news-empty]')!.hidden = visible > 0;
    document.querySelectorAll<HTMLElement>('[data-filter-category]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filterCategory === state.category)));
    document.querySelectorAll<HTMLElement>('[data-filter-lang]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filterLang === state.lang)));
  }

  document.querySelector('[data-news-filters]')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!btn) return;
    if (btn.dataset.filterCategory) state.category = btn.dataset.filterCategory;
    if (btn.dataset.filterLang) state.lang = btn.dataset.filterLang;
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify(state));
    } catch {
      // Ignora: o filtro só não fica salvo.
    }
    applyFilter();
  });

  applyFilter();

  every(REFRESH_MS, async () => {
    const news = await fetchLatest<NewsData>('news');
    if (!news) return;
    setHtml('[data-news-list]', renderNewsItems(news.items, { now: Date.now() }));
    setStamp('news', news.updatedAt);
    applyFilter();
  });
</script>
